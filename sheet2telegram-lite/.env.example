# ---- Telegram ----------------------------------------------------------
# From @BotFather after /newbot
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenReplaceMe
# Group IDs start with -100. See the README for how to find yours.
TELEGRAM_CHAT_ID=-1001234567890

# ---- Google Sheet ------------------------------------------------------
# The long id in the sheet URL: docs.google.com/spreadsheets/d/<SHEET_ID>/edit
SHEET_ID=1a2b3c4d5e6f7g8h9i0jExampleReplaceMe
# Tab name and cell range to read
SHEET_RANGE=Sheet1!A1:F1000

# ---- Which columns hold what ------------------------------------------
DATE_COLUMN=A
AMOUNT_COLUMN=D
# Optional. Leave blank to skip the "Top item" line.
PRODUCT_COLUMN=
# Set to false if row 1 is data rather than headers
HAS_HEADER=true

# ---- Report formatting -------------------------------------------------
REPORT_TITLE=Daily Sales Report
CURRENCY=$
# How dates are written in your sheet
DATE_FORMAT=%Y-%m-%d
# IANA timezone used to work out "yesterday"
TIMEZONE=Asia/Dhaka
# 1 = report on yesterday, 0 = report on today
DAYS_BACK=1
